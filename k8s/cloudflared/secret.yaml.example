# secret.yaml.example — DO NOT commit the real secret!
#
# After creating the Cloudflare Tunnel (Step 7), create the secret
# by running this command on the VM:
#
#   kubectl create namespace cloudflared
#   kubectl create secret generic cloudflared-credentials \
#     --namespace cloudflared \
#     --from-file=credentials.json=$HOME/.cloudflared/<TUNNEL_ID>.json
#
# The credentials.json file is automatically created by cloudflared
# when you run "cloudflared tunnel create k3s-tunnel"
